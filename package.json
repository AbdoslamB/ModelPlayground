{
  "name": "modelplayground",
  "private": true,
  "type": "module",
  "homepage": "https://abdoslamb.github.io/ModelPlayground/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro sync && eslint --cache --max-warnings 0 . && stylelint --max-warnings 0 \"src/**/*.css\"",
    "format": "prettier --cache --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/check-page-weight.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.1.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/figtree": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "astro": "7.4.2",
    "d3-array": "3.2.4",
    "katex": "0.19.1",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/d3-array": "3.2.2",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
