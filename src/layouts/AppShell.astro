---
import { url } from '../lib/base-url';
import { byCategory, comingSoonModels, readyModels } from '../models/registry';
import '@fontsource-variable/figtree';

import '../styles/base.css';
import Logo from '../ui/Logo.astro';

interface Props {
  title: string;
  description: string;
  /** Slug of the model shown on this page, to mark it in the sidebar. */
  currentSlug?: string;
  /** Short name for the phone top bar. */
  topbarTitle?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  currentSlug,
  topbarTitle = 'Model Playground',
  noindex = false,
} = Astro.props;

const pageTitle =
  title === 'Model Playground' ? title : `${title} · Model Playground`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const readyGroups = byCategory(readyModels);
const soonGroups = byCategory(comingSoonModels);
const currentIsSoon = comingSoonModels.some((m) => m.slug === currentSlug);
const repoUrl = 'https://github.com/AbdoslamB/ModelPlayground';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <script is:inline>
      // Runs before the first paint: theme override, "JavaScript is on", and
      // a sidebar the visitor collapsed last time.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const theme = localStorage.getItem('mlp:theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
          if (localStorage.getItem('mlp:sidebar') === 'collapsed') {
            root.setAttribute('data-sidebar-collapsed', '');
          }
        } catch {
          // Storage blocked: follow the system theme, sidebar open.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="shell">
      <header class="topbar" data-topbar>
        <button
          class="topbar__menu"
          type="button"
          aria-expanded="false"
          aria-controls="sidebar"
          data-menu-button
        >
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M3 5h14M3 10h14M3 15h14"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>
          <span class="visually-hidden">Open the model list</span>
        </button>
        <span class="topbar__title">{topbarTitle}</span>
      </header>

      <div class="scrim" data-scrim></div>

      <aside class="sidebar" id="sidebar" data-sidebar>
        <div class="sidebar__inner">
          <div class="sidebar__head">
            <a class="brand" href={url()}>
              <Logo />
              <span>Model Playground</span>
            </a>
            <button
              class="collapse"
              type="button"
              aria-expanded="true"
              aria-controls="sidebar-content"
              data-collapse-button
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <rect
                  x="2.5"
                  y="3.5"
                  width="15"
                  height="13"
                  rx="2.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                ></rect>
                <path
                  d="M7.5 3.5v13"
                  stroke="currentColor"
                  stroke-width="1.5"
                ></path>
              </svg>
              <span class="visually-hidden" data-collapse-label>
                Hide the model list
              </span>
            </button>
          </div>
          <div class="sidebar__content" id="sidebar-content">
            <nav aria-label="Models" class="models">
              {readyGroups.map((group) => (
                <section class="models__group">
                  <h2 class="models__category">{group.category}</h2>
                  <ul>
                    {group.models.map((model) => (
                      <li>
                        <a
                          class="models__link"
                          href={url(`models/${model.slug}`)}
                          aria-current={
                            model.slug === currentSlug ? 'page' : undefined
                          }
                        >
                          {model.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}

              {comingSoonModels.length > 0 && (
                <details class="soon" open={currentIsSoon}>
                  <summary class="soon__summary">
                    Coming soon{' '}
                    <span class="soon__count num">
                      {comingSoonModels.length}
                    </span>
                  </summary>
                  {soonGroups.map((group) => (
                    <section class="models__group">
                      <h2 class="models__category">{group.category}</h2>
                      <ul>
                        {group.models.map((model) => (
                          <li>
                            <a
                              class="models__link models__link--soon"
                              href={url(`models/${model.slug}`)}
                              aria-current={
                                model.slug === currentSlug ? 'page' : undefined
                              }
                            >
                              {model.title}
                              <span class="badge">Soon</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </details>
              )}
            </nav>

            <div class="sidebar__footer">
              <button
                class="theme-toggle"
                type="button"
                aria-pressed="false"
                data-theme-toggle
              >
                <svg
                  class="theme-toggle__icon"
                  width="18"
                  height="18"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path
                    d="M16.5 12.5A7 7 0 0 1 7.5 3.5a7 7 0 1 0 9 9Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                Dark mode
              </button>
              <a class="footer-link" href={repoUrl}>
                GitHub
              </a>
            </div>
          </div>
        </div>
      </aside>

      <main id="main" tabindex="-1" data-main>
        <slot />
      </main>
    </div>

    <script>
      const root = document.documentElement;
      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      const menuButton =
        document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const scrim = document.querySelector<HTMLElement>('[data-scrim]');
      const main = document.querySelector<HTMLElement>('[data-main]');
      const topbar = document.querySelector<HTMLElement>('[data-topbar]');
      const themeToggle = document.querySelector<HTMLButtonElement>(
        '[data-theme-toggle]',
      );
      const drawerQuery = matchMedia('(width < 1024px)');
      const darkQuery = matchMedia('(prefers-color-scheme: dark)');

      // Drawer (below 1024 px): focus stays inside, Esc / scrim / a link close it.
      function setDrawer(open: boolean) {
        root.toggleAttribute('data-drawer-open', open);
        menuButton?.setAttribute('aria-expanded', String(open));
        if (main) main.inert = open;
        if (topbar) topbar.inert = open;
        if (open) sidebar?.querySelector<HTMLElement>('a, button')?.focus();
        else menuButton?.focus();
      }
      menuButton?.addEventListener('click', () => {
        setDrawer(true);
      });
      scrim?.addEventListener('click', () => {
        setDrawer(false);
      });
      sidebar?.addEventListener('click', (event) => {
        if (
          drawerQuery.matches &&
          event.target instanceof Element &&
          event.target.closest('a')
        ) {
          setDrawer(false);
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && root.hasAttribute('data-drawer-open')) {
          setDrawer(false);
        }
      });
      drawerQuery.addEventListener('change', () => {
        if (root.hasAttribute('data-drawer-open')) setDrawer(false);
      });

      // Desktop: the sidebar collapses to a slim rail, and is remembered.
      const collapseButton = document.querySelector<HTMLButtonElement>(
        '[data-collapse-button]',
      );
      const collapseLabel = document.querySelector<HTMLElement>(
        '[data-collapse-label]',
      );
      function showCollapsed() {
        const collapsed = root.hasAttribute('data-sidebar-collapsed');
        collapseButton?.setAttribute('aria-expanded', String(!collapsed));
        if (collapseLabel) {
          collapseLabel.textContent = collapsed
            ? 'Show the model list'
            : 'Hide the model list';
        }
      }
      collapseButton?.addEventListener('click', () => {
        const collapsed = !root.hasAttribute('data-sidebar-collapsed');
        root.toggleAttribute('data-sidebar-collapsed', collapsed);
        try {
          localStorage.setItem('mlp:sidebar', collapsed ? 'collapsed' : 'open');
        } catch {
          // Storage blocked: the choice lasts for this page only.
        }
        showCollapsed();
      });
      showCollapsed();

      // Theme switch: overrides the system setting and is remembered.
      function isDark() {
        const forced = root.dataset.theme;
        return forced ? forced === 'dark' : darkQuery.matches;
      }
      function showTheme() {
        themeToggle?.setAttribute('aria-pressed', String(isDark()));
      }
      themeToggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('mlp:theme', next);
        } catch {
          // Storage blocked: the choice lasts for this page only.
        }
        showTheme();
      });
      darkQuery.addEventListener('change', showTheme);
      showTheme();

      // Phone top bar hides while scrolling down and returns on scroll up.
      const phoneQuery = matchMedia('(width < 768px)');
      let lastY = scrollY;
      let ticking = false;
      function updateTopbar() {
        ticking = false;
        const y = scrollY;
        const hide = phoneQuery.matches && y > lastY + 4 && y > 80;
        const show = !phoneQuery.matches || y < lastY - 4 || y <= 80;
        if (hide) root.setAttribute('data-topbar-hidden', '');
        else if (show) root.removeAttribute('data-topbar-hidden');
        if (hide || show) lastY = y;
      }
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateTopbar);
          }
        },
        { passive: true },
      );
    </script>

    <style>
      .shell {
        min-height: 100dvh;
      }

      main {
        min-width: 0;
        outline: none;
      }

      /* Top bar: phones and tablets only. */
      .topbar {
        position: sticky;
        inset-block-start: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: var(--s-2);
        height: var(--topbar-height);
        padding-inline: var(--s-2) var(--s-4);
        border-block-end: 1px solid var(--c-hairline);
        background: color-mix(in srgb, var(--c-bg) 92%, transparent);
        backdrop-filter: blur(8px);
        transition: transform var(--dur-tween) var(--ease-out);
      }

      :global([data-topbar-hidden]) .topbar {
        transform: translateY(-100%);
      }

      .topbar__menu {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: var(--radius-control);
        background: transparent;
      }

      .topbar__menu:hover {
        background: var(--c-surface-sunken);
      }

      .topbar__title {
        overflow: hidden;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* Sidebar */
      .sidebar {
        view-transition-name: sidebar;
        background: var(--c-bg);
      }

      .sidebar__inner {
        display: flex;
        flex-direction: column;
        gap: var(--s-6);
        height: 100%;
        padding: var(--s-6) var(--s-4) var(--s-4);
        overflow-y: auto;
        overscroll-behavior: contain;
      }

      .sidebar__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-2);
      }

      .sidebar__content {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--s-6);
        min-height: 0;
      }

      .collapse {
        display: none;
        flex: none;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: var(--radius-control);
        background: transparent;
        color: var(--c-muted);
      }

      .collapse:hover {
        background: var(--c-surface-sunken);
        color: var(--c-text);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        min-width: 0;
        padding-inline: var(--s-1);
        color: var(--c-text);
        font-size: var(--fs-16);
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
      }

      .models {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--s-4);
      }

      .models ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .models__category {
        padding: 0 var(--s-2) var(--s-1);
        color: var(--c-muted);
        font-size: var(--fs-12);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .models__link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-2);
        min-height: 40px;
        padding: var(--s-2);
        border-radius: var(--radius-control);
        color: var(--c-text);
        font-size: var(--fs-14);
        text-decoration: none;
      }

      .models__link:hover {
        background: var(--c-surface-sunken);
      }

      .models__link[aria-current='page'] {
        background: var(--c-surface-sunken);
        font-weight: 700;
        box-shadow: inset 0 0 0 1px var(--c-hairline);
      }

      .models__link[aria-current='page']::before {
        position: absolute;
        inset-block: 8px;
        inset-inline-start: -2px;
        width: 3px;
        border-radius: 2px;
        background: var(--c-line);
        content: '';
      }

      .models__link--soon {
        color: var(--c-muted);
      }

      .badge {
        padding: 0 6px;
        border: 1px solid var(--c-hairline);
        border-radius: 999px;
        color: var(--c-muted);
        font-size: var(--fs-12);
        font-weight: 500;
      }

      .soon {
        display: flex;
        flex-direction: column;
        gap: var(--s-3);
      }

      .soon__summary {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        min-height: 40px;
        padding: var(--s-2);
        border-radius: var(--radius-control);
        color: var(--c-muted);
        font-size: var(--fs-14);
        font-weight: 600;
        cursor: pointer;
      }

      .soon__summary:hover {
        background: var(--c-surface-sunken);
      }

      .soon[open] .soon__summary {
        margin-block-end: var(--s-2);
      }

      .soon__count {
        padding: 0 6px;
        border-radius: 999px;
        background: var(--c-surface-sunken);
        font-size: var(--fs-12);
      }

      .sidebar__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-2);
        padding-block-start: var(--s-4);
        border-block-start: 1px solid var(--c-hairline);
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: var(--s-2);
        min-height: 44px;
        padding: 0 var(--s-3);
        border: 1px solid var(--c-hairline);
        border-radius: var(--radius-control);
        background: var(--c-surface);
        font-size: var(--fs-14);
      }

      .theme-toggle[aria-pressed='true'] {
        border-color: var(--c-control-edge);
      }

      .footer-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 var(--s-2);
        color: var(--c-muted);
        font-size: var(--fs-14);
      }

      .scrim {
        display: none;
      }

      /* Desktop: the sidebar is open, or collapsed to a slim rail. */
      @media (width >= 1024px) {
        .shell {
          display: grid;
          grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
          transition: grid-template-columns var(--dur-tween) var(--ease-out);
        }

        .collapse {
          display: grid;
        }

        :global([data-sidebar-collapsed]) .shell {
          grid-template-columns: 64px minmax(0, 1fr);
        }

        :global([data-sidebar-collapsed]) .sidebar__inner {
          padding-inline: var(--s-3);
        }

        :global([data-sidebar-collapsed]) .brand,
        :global([data-sidebar-collapsed]) .sidebar__content {
          display: none;
        }

        .topbar {
          display: none;
        }

        .sidebar {
          position: sticky;
          inset-block-start: 0;
          height: 100dvh;
          border-inline-end: 1px solid var(--c-hairline);
        }
      }

      /* Phones and tablets: the sidebar is a drawer. */
      @media (width < 1024px) {
        .sidebar {
          position: fixed;
          inset-block: 0;
          inset-inline-start: 0;
          z-index: 40;
          width: min(300px, 85vw);
          box-shadow: var(--shadow-float);
          visibility: hidden;
          transform: translateX(-100%);
          transition:
            transform var(--dur-tween) var(--ease-out),
            visibility 0s linear var(--dur-tween);
        }

        :global([data-drawer-open]) .sidebar {
          visibility: visible;
          transform: none;
          transition: transform var(--dur-tween) var(--ease-out);
        }

        :global([data-drawer-open]) .scrim {
          position: fixed;
          inset: 0;
          z-index: 30;
          display: block;
          background: rgb(0 0 0 / 35%);
        }

        :global([data-drawer-open]) body {
          overflow: hidden;
        }
      }

      @media (width < 768px) {
        .sidebar {
          width: 85vw;
        }
      }
    </style>
  </body>
</html>
