---
// The site's logo, the same mark as public/favicon.svg: a data disc and a
// model ring. Its colours follow the site's theme rather than the system's.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle class="logo__disc" cx="11.5" cy="16" r="9.5"></circle>
  <circle
    class="logo__ring"
    cx="20.5"
    cy="16"
    r="9.5"
    fill="none"
    stroke-width="2.6"
  ></circle>
</svg>

<style>
  .logo__disc {
    fill: light-dark(#0072b2, #38bdf8);
  }

  .logo__ring {
    stroke: light-dark(#1f2328, #f8fafc);
  }
</style>
