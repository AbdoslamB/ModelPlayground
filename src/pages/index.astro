---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

import AppShell from '../layouts/AppShell.astro';
import { modelUrl } from '../lib/base-url';
import { byCategory, comingSoonModels, readyModels } from '../models/registry';

const previews = import.meta.glob<{ default: AstroComponentFactory }>(
  '../models/*/Preview.astro',
  { eager: true },
);
const cards = readyModels.map((meta) => ({
  meta,
  Preview: previews[`../models/${meta.slug}/Preview.astro`]?.default,
}));
const first = readyModels[0];
---

<AppShell
  title="Model Playground"
  description="Learn machine learning by moving things: change a model and watch the graph, the equation and the numbers respond."
>
  <div class="home">
    <header class="hero">
      <h1>Learn machine learning by moving things.</h1>
      <p class="hero__promise">
        Every model here is a small lab. Drag, slide and click, and watch the
        graph, the equation and the numbers change together.
      </p>
      {first && (
        <a
          class="button button--primary hero__start"
          href={modelUrl(first.slug)}
        >
          Start with {first.title}
        </a>
      )}
    </header>

    <section aria-labelledby="ready-title" class="section">
      <h2 id="ready-title" class="section__title">
        Ready to explore
      </h2>
      <ul class="cards">
        {cards.map(({ meta, Preview }) => (
          <li>
            <a class="card" href={modelUrl(meta.slug)}>
              {Preview && (
                <div class="card__preview">
                  <Preview />
                </div>
              )}
              <div class="card__body">
                <span class="card__category">{meta.category}</span>
                <h3 class="card__title">{meta.title}</h3>
                <p class="card__summary">{meta.summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {comingSoonModels.length > 0 && (
      <section aria-labelledby="coming-soon" class="section">
        <h2 id="coming-soon" class="section__title">
          Coming soon
        </h2>
        <div class="soon-groups">
          {byCategory(comingSoonModels).map((group) => (
            <div class="soon-group">
              <h3 class="soon-group__title">{group.category}</h3>
              <ul>
                {group.models.map((model) => (
                  <li>
                    <a href={modelUrl(model.slug)}>{model.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</AppShell>

<style>
  .home {
    display: grid;
    gap: var(--s-12);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--s-12) var(--s-6) var(--s-16);
  }

  @media (width < 768px) {
    .home {
      gap: var(--s-8);
      padding: var(--s-6) var(--s-4) var(--s-12);
    }
  }

  .hero {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    max-width: 44rem;
  }

  .hero h1 {
    font-size: var(--fs-38);
    letter-spacing: -0.015em;
  }

  .hero__promise {
    color: var(--c-muted);
    font-size: var(--fs-18);
  }

  .hero__start {
    margin-block-start: var(--s-2);
  }

  .section {
    display: grid;
    gap: var(--s-4);
  }

  .section__title {
    font-size: var(--fs-20);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    transition:
      border-color var(--dur-ui),
      box-shadow var(--dur-ui);
  }

  .card:hover {
    border-color: var(--c-control-edge);
    box-shadow: var(--shadow-float);
  }

  .card__preview {
    padding: var(--s-3) var(--s-3) 0;
  }

  .card__preview :global(svg) {
    width: 100%;
    height: auto;
  }

  .card__body {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4);
  }

  .card__category {
    color: var(--c-muted);
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card__title {
    font-size: var(--fs-20);
  }

  .card__summary {
    color: var(--c-muted);
  }

  .soon-groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--s-6);
  }

  .soon-group {
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }

  .soon-group__title {
    color: var(--c-muted);
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .soon-group ul {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soon-group a {
    color: var(--c-text);
    text-decoration: none;
  }

  .soon-group a:hover {
    color: var(--c-line-ink);
    text-decoration: underline;
  }
</style>
