---
import 'katex/dist/katex.min.css';

import ModelLayout from '../../layouts/ModelLayout.astro';
import { renderTex } from '../../lib/katex';
import { datasets } from './data';
import { equations } from './equations';
import Explain from './Explain.astro';
import Lab from './Lab.svelte';
import { meta } from './meta';

const objective = equations.find((e) => e.id === 'objective');
const formula = objective ? renderTex(objective.tex) : '';
const dataset = datasets[0];
if (!dataset) throw new Error('k-Means has no data');
---

<ModelLayout meta={meta}>
  <p slot="lead">
    Drag the stands, or press Step and Run. Everyone walks to their nearest
    stand.
  </p>
  <Lab slot="lab" client:load dataset={dataset} formula={formula} />
  <Explain slot="explain" />
</ModelLayout>
